    "@sparticuz/chromium": "149.0.0",
    "dotenv": "latest",
    "mineflayer": "latest",
    "pngjs": "7.0.0",
    "prismarine-viewer": "latest",
    "puppeteer-core": "25.3.0",
    "telegraf": "latest"
  }
}
